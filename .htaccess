# Vehicle Sampark Clean Hostinger Rewrite Rules
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Custom 404 Error Handler
    ErrorDocument 404 /404.php

    # Admin Custom Extensionless Clean Routes
    RewriteRule ^admin-qr-login/?$ login.php [L,QSA]
    RewriteRule ^admin-qr-dashboard/?$ dashboard.php [L,QSA]
    RewriteRule ^admin-qr-batches/?$ batches.php [L,QSA]
    RewriteRule ^admin-qr-profile/?$ profile.php [L,QSA]
    RewriteRule ^admin-qr-api/?$ api.php [L,QSA]
    RewriteRule ^admin-qr-single-pdf/?$ single_pdf.php [L,QSA]
    RewriteRule ^admin-qr-batch-pdf/?$ batch_pdf.php [L,QSA]
</IfModule>
